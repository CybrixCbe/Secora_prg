# Google Identity Services (Client-Side GIS)
# Obtain this OAuth 2.0 Web Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   - http://localhost:5173
#   - http://localhost:3000
#   - http://localhost:3001
#   - https://cybrixcbe.github.io
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Backend Environment Variables (Optional / Express API Dev Server)
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
PORT=3000

# Firebase Authentication (Optional client-side fallback/bridging)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

